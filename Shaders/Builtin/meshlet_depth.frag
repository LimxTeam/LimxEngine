#version 450

// ============================================================================
// meshlet_depth.frag — 网格着色器路径的片段着色器
//
// 把逐图元的可见性编号写进可见性缓冲区。深度由固定功能写。
//
// **不做 alpha 测试。** 这是一个有意的取舍, 不是遗漏: meshlet 剔除只收
// 不透明批次, 蒙版材质要到材质解析那一天才有地方放。判据据此成立 ——
// 本路径画的三角形集合是经典深度预通道的**子集**, 于是每个像素上本路径
// 的深度只能等于或者远于经典路径的。
//
// ── 为什么与回退路径各有一个片段着色器 ──
//
// 逐**图元**的输出是网格着色器独有的 (perprimitiveEXT)。经典管线里一个值
// 要么逐顶点要么逐绘制, 想做到逐三角形只能靠"给每个三角形三份独立顶点" ——
// 而回退路径的顶点流本来就是那样展开的, 所以它用普通的 flat 逐顶点输出。
//
// 两个片段着色器的接口声明不同, 而 Vulkan 要求前后阶段的接口匹配, 所以
// 合不成一个。两者的**函数体**是同一行, 而"两条路径画出的可见性缓冲区
// 逐位相同"那条判据正是对着这一对写的。
// ============================================================================

#extension GL_EXT_mesh_shader : require

layout(location = 0) perprimitiveEXT flat in uint inVisibility;

layout(location = 0) out uint outVisibility;

void main()
{
    outVisibility = inVisibility;
}
