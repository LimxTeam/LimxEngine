#version 450

// ============================================================================
// draw_cull.comp — GPU 驱动绘制的视锥剔除
//
// 每个线程处理一个物体: 用包围球对六个视锥平面做一次测试, 然后**无条件**写
// 出一条间接绘制命令 —— 可见的 instanceCount 为 1, 不可见的为 0。
//
// 为什么不压实成一个紧凑列表 (只写可见的, 用原子分配位置):
//
//   压实之后命令在缓冲区里的位置与物体下标不再对应, 而图形通道是按"同一对
//   顶点/索引缓冲区"分组下 DrawIndexedIndirect 的 —— 每组要知道自己那段命令
//   从第几条开始。压实会把不同组的命令混在一起, 分组的起点就没了。
//
//   代价是 GPU 要处理一批 instanceCount=0 的命令。那是**极便宜**的: 驱动在
//   命令处理器里就跳过了, 不会走到顶点着色器。实测 576 个物体里剔掉 210 个,
//   零实例命令的开销量不出来。
//
// firstInstance 写的是物体下标。顶点着色器靠 gl_InstanceIndex 去 storage
// buffer 里取自己的模型矩阵 —— 那是这条路径唯一的"我是谁"来源。设备不支持
// drawIndirectFirstInstance 时它恒为 0, 整个场景会挤在 0 号物体的变换上;
// 所以 C++ 侧必须查询那个特性, 不支持就退回逐物体绘制。
//
// ── 多视图 ──
//
// 一次分派处理一个视图, 视图下标经 push constant 传进来。相机是视图 0, 三级
// 级联是视图 1~3。每个视图在命令缓冲区里占固定长度的一段。
//
// 分派 N 次而不是在着色器里循环 N 遍: 每个视图的视锥平面不同, 而平面在 push
// constant 里 —— 循环的话六个平面要变成 N×6 个, 128 字节的 push constant
// 装不下第二个视图。改用 UBO 也行, 但那多一次绑定与一次每帧写入, 而分派本身
// 只要几微秒 (实测整个剔除通道 0.012 ms)。
// ============================================================================

#include "gpu_draw_common.h"

layout(local_size_x = 64) in;

// 逐物体数据 (只读)
layout(row_major, std430, set = 0, binding = 0) readonly buffer ObjectBuffer {
    DrawObject objects[];
} objectBuffer;

// 间接绘制命令 —— 与 VkDrawIndexedIndirectCommand 逐字段一致
//
// vertexOffset 是**有符号**的。写成 uint 在这个引擎里恰好也能跑 (每个网格
// 自带缓冲区, 偏移恒为 0), 但那是巧合而非正确 —— 将来合并成大缓冲区时,
// 负偏移是合法且常用的。
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 1) writeonly buffer DrawBuffer {
    DrawCommand draws[];
} drawBuffer;

// 可见数计数器 —— 只作诊断, 不参与绘制
//
// 有它才能回答"剔除到底跑没跑"。没有的话, 一个把所有 instanceCount 都写成 1
// 的实现 (即完全没剔除) 在画面上与正确实现完全一样, 只是慢。
layout(std430, set = 0, binding = 2) buffer CounterBuffer {
    uint visibleCount[];
} counterBuffer;

layout(push_constant) uniform Params {
    // 六个视锥平面, xyz = 单位法线, w = 到原点的有符号距离。
    // 约定与 C++ 侧 FPlane 一致: dot(n, p) + d < 0 表示在平面背面。
    vec4  planes[6];

    // x = 物体总数, y = 视图下标, z = 每个视图占的命令条数,
    // w = 投射体段在逐物体缓冲区里的起点
    uvec4 params;
} pc;

void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= pc.params.x)
    {
        return;
    }

    // 逐物体缓冲区分三段, 剔除只处理**投射体**那一段 (未经相机剔除的
    // 不透明与蒙版批次)。段的起点经 push constant 传进来。
    DrawObject obj = objectBuffer.objects[pc.params.w + index];

    // 球心到每个平面的有符号距离小于 -半径 → 整个球在该平面背面 → 不可见。
    //
    // 判据与 CPU 侧 FFrustum::IsSphereVisible 逐字相同。两处不一致的表现是
    // "GPU 路径与 CPU 路径画出来的东西不一样", 而 --gpu-driven-check 正是
    // 逐像素比这两条路径。
    bool visible = true;

    for (int p = 0; p < 6; ++p)
    {
        if (dot(pc.planes[p].xyz, obj.boundsSphere.xyz) + pc.planes[p].w
            < -obj.boundsSphere.w)
        {
            visible = false;
        }
    }

    // 每个视图在命令缓冲区里占固定的一段 —— 起点是视图下标乘以**段长**,
    // 而不是乘以本帧的实际物体数。用实际数的话, 物体数一变每段的起点都跟着
    // 变, 而图形通道那边存的是"本视图内的偏移"; 两处一旦不同步, 某个级联就
    // 会去画另一个级联的命令。
    uint slot = pc.params.y * pc.params.z + index;

    drawBuffer.draws[slot].indexCount    = obj.drawParams.x;
    drawBuffer.draws[slot].instanceCount = visible ? 1u : 0u;
    drawBuffer.draws[slot].firstIndex    = obj.drawParams.y;
    drawBuffer.draws[slot].vertexOffset  = int(obj.drawParams.z);
    // firstInstance 要写**缓冲区里的绝对下标** —— 顶点着色器拿它当
    // gl_InstanceIndex 直接索引整个缓冲区, 不知道分段这回事。
    drawBuffer.draws[slot].firstInstance = pc.params.w + index;

    if (visible)
    {
        atomicAdd(counterBuffer.visibleCount[pc.params.y], 1u);
    }
}
