#version 450

// ============================================================================
// meshlet_cull.comp — 两级剔除的第二级: meshlet
//
// 一个工作组一个**可见实例** (第一级压实出来的那张表), 组内的线程跨步遍历
// 该实例的全部 meshlet。活下来的压实进一张 (实例, meshlet) 对的表。
//
// 为什么一个工作组一个实例, 而不是一个线程一个 meshlet:
//
//   一个线程一个 meshlet 要先算出"全场景第 i 个 meshlet 属于哪个实例",
//   那需要一张前缀和表, 而那张表每帧都要重建 (实例可见性每帧都在变)。
//   一个工作组一个实例的话, 实例是谁由 gl_WorkGroupID 直接给出。
//
//   代价是负载不均: 一个只有 3 个 meshlet 的实例也占一个完整工作组。
//   真实场景里 meshlet 数的分布很宽, 这个代价是实打实的 —— 但它换掉的
//   是每帧一趟前缀和外加一次额外的同步。
//
// 两条剔除判据都在 meshlet_common.h 里, 与 CPU 的参考实现同一份书写。
// ============================================================================

#include "meshlet_common.h"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer InstanceBuffer {
    MeshletInstance instances[];
} instanceBuffer;

layout(std430, set = 0, binding = 1) readonly buffer MeshletBuffer {
    Meshlet meshlets[];
} meshletBuffer;

layout(std430, set = 0, binding = 2) readonly buffer VisibleInstanceBuffer {
    uint visible[];
} visibleBuffer;

// 压实后的可见 meshlet —— x = 实例下标, y = meshlet 下标 (全局)
layout(std430, set = 0, binding = 3) writeonly buffer VisibleMeshletBuffer {
    uvec2 visible[];
} outputBuffer;

// x = 可见 meshlet 数
// y = 因视锥被剔的数
// z = 因背面被剔的数
// w = 参与测试的总数
//
// 后三个只作诊断, 但缺了就答不上"剔除到底跑没跑"。一个什么都不剔的实现
// 在画面上与正确实现完全一样, 只是慢 —— 那正是本周期反复遇到的那一类。
layout(std430, set = 0, binding = 4) buffer CounterBuffer {
    uvec4 counters;
} counterBuffer;

// 第一阶段被**遮挡**剔掉的 (实例, meshlet) 对。
//
// 只收被遮挡剔掉的, 不收被视锥或背面剔掉的: 后两者与相机的关系这一帧
// 不会再变, 重测一遍是纯浪费。而遮挡用的是**上一帧**的金字塔, 这一帧
// 的深度画完之后结论可能翻转 —— 那正是第二阶段存在的理由。
layout(std430, set = 0, binding = 5) writeonly buffer PendingBuffer {
    uvec2 pending[];
} pendingBuffer;

// x = 待定数, y/z/w = 保留
layout(std430, set = 0, binding = 6) buffer PendingCounterBuffer {
    uvec4 counters;
} pendingCounter;

// 上一帧的层次深度金字塔
layout(set = 0, binding = 7) uniform sampler2D hizPyramid;

layout(row_major, set = 0, binding = 8) uniform ViewBuffer {
    MeshletCullView view;
} viewBuffer;

layout(push_constant) uniform Params {
    // x = 可见实例数, y = 输出表容量, z = 背面剔除开关,
    // w = 遮挡剔除开关 (0 = 关; 金字塔无效时 C++ 侧就传 0)
    uvec4 params;
} pc;

void main()
{
    const uint group = gl_WorkGroupID.x;

    if (group >= pc.params.x)
    {
        return;
    }

    const uint instanceIndex = visibleBuffer.visible[group];

    const MeshletInstance instance = instanceBuffer.instances[instanceIndex];

    const uint meshletBase  = instance.meshletRange.x;
    const uint meshletCount = instance.meshletRange.y;

    for (uint i = gl_LocalInvocationID.x; i < meshletCount;
         i += gl_WorkGroupSize.x)
    {
        const uint meshletIndex = meshletBase + i;

        const Meshlet meshlet = meshletBuffer.meshlets[meshletIndex];

        const vec4 worldSphere = MeshletWorldSphere(
            meshlet.boundingSphere, instance.transformRow0,
            instance.transformRow1, instance.transformRow2);

        atomicAdd(counterBuffer.counters.w, 1u);

        if (!MeshletSphereVisible(worldSphere, viewBuffer.view.planes))
        {
            atomicAdd(counterBuffer.counters.y, 1u);
            continue;
        }

        if (pc.params.z != 0u &&
            MeshletBackfaceCull(meshlet.normalCone, worldSphere,
                                viewBuffer.view.cameraPosition.xyz, instance.transformRow0,
                                instance.transformRow1,
                                instance.transformRow2))
        {
            atomicAdd(counterBuffer.counters.z, 1u);
            continue;
        }

        // ---- 遮挡剔除 ----
        //
        // 用的是**上一帧**的金字塔, 所以结论可能是错的 (这一帧才露出来的
        // 东西会被判成挡住)。被它剔掉的进待定表, 等这一帧的深度画完、
        // 金字塔重建之后再测一遍 —— 那是第二阶段。
        //
        // 单阶段的话这里就是最终答案, 而"上一帧挡住这一帧露出来"表现为
        // 物体闪一帧才出现。两阶段之后这条路上不再有近似。
        if (pc.params.w != 0u)
        {
            vec4  rect    = vec4(0.0);
            float nearest = 0.0;

            const bool projected = MeshletProjectSphere(
                worldSphere, viewBuffer.view.viewProj, viewBuffer.view.cameraPosition.xyz,
                viewBuffer.view.hizParams.xy, viewBuffer.view.hizParams.w, rect, nearest);

            if (projected &&
                MeshletHizOccluded(rect, nearest, hizPyramid,
                                   viewBuffer.view.hizParams.xy, viewBuffer.view.hizParams.z))
            {
                const uint pendingSlot =
                    atomicAdd(pendingCounter.counters.x, 1u);

                if (pendingSlot < pc.params.y)
                {
                    pendingBuffer.pending[pendingSlot] =
                        uvec2(instanceIndex, meshletIndex);
                }

                continue;
            }
        }

        const uint slot = atomicAdd(counterBuffer.counters.x, 1u);

        // 容量不够时丢掉而不是越界写 —— 理由与第一级同。
        if (slot < pc.params.y)
        {
            outputBuffer.visible[slot] = uvec2(instanceIndex, meshletIndex);
        }
    }
}
