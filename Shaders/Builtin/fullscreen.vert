#version 450

// ============================================================
// 全屏三角形顶点着色器 — 不使用任何顶点缓冲区
//
// 用一个覆盖整屏的**三角形**而非两个三角形拼的四边形: 四边形的对角线
// 会把屏幕切成两半, 光栅化时对角线两侧分属不同图元, 边界处的 2x2 像素
// 四方格被拆开, 导数 (dFdx/dFdy) 与四方格利用率都受损。单个大三角形
// 没有内部边界。
//
// 顶点由 gl_VertexIndex 直接算出, 因此 vkCmdDraw(3, 1, 0, 0) 即可,
// 不需要顶点缓冲区、不需要顶点输入状态。
//
//   索引 0 → (-1, -1)  UV (0, 0)
//   索引 1 → ( 3, -1)  UV (2, 0)
//   索引 2 → (-1,  3)  UV (0, 2)
//
// 超出 [-1,1] 的部分被裁剪掉, 留下的正好是整个屏幕。
// ============================================================

layout(location = 0) out vec2 fragUV;

void main()
{
    fragUV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
    gl_Position = vec4(fragUV * 2.0 - 1.0, 0.0, 1.0);
}
